{
  "name": "alarm-automation-electron",
  "version": "1.6.0",
  "description": "营运车辆报警申诉自动化工具（人脸聚类 + 停靠段拼图）",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "download-models": "node scripts/download-models.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.example.alarm-automation",
    "productName": "报警申诉自动化工具",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "renderer/**/*",
      "automation/**/*"
    ],
    "extraResources": [
      {
        "from": "models/insightface",
        "to": "models/insightface"
      },
      {
        "from": "vendor/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      }
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/@img/**",
      "**/node_modules/tesseract.js-core/**",
      "**/node_modules/@tesseract.js-data/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "axios": "^1.20.0",
    "fs-extra": "^11.4.0",
    "onnxruntime-node": "^1.23.2",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "1.3.3",
    "@img/sharp-win32-x64": "0.35.4"
  }
}
