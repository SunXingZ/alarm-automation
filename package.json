{
  "name": "alarm-automation-electron",
  "version": "1.1.0",
  "description": "",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.example.alarm-automation",
    "productName": "报警申诉自动化工具",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "renderer/**/*",
      "automation/**/*",
      "models/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@tensorflow/tfjs-node/**",
      "**/node_modules/@img/**",
      "**/node_modules/tesseract.js-core/**",
      "**/node_modules/@tesseract.js-data/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.20.0",
    "fs-extra": "^11.4.0",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "1.3.3",
    "@img/sharp-win32-x64": "0.35.4"
  }
}
